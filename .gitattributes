# ------------------------------------------------------------
# 行尾约定：仓库在 Windows 上开发、在 Linux 上发布。
# 若 .sh 被检出成 CRLF，服务器上会报 "bad interpreter: /bin/bash^M"。
# 只对脚本做定点约束，不做全仓库 text=auto 归一化（避免一次性刷爆 diff）。
# ------------------------------------------------------------
*.sh text eol=lf
deploy/nginx/*.conf text eol=lf

[Unit]
Description=P3_blog admin server (loopback-only, proxied by BT nginx)
Documentation=file:/srv/blog/repo/deploy/PLAN-ADMIN-LIVE.md
After=network.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/srv/blog/repo

# PATH 必须显式给出：systemd 不给继承登录 shell 的 PATH，而 node 装在
# /usr/local/bin。用 /usr/bin/env node 或裸 node 都会以 "command not found" 失败。
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# 运行时数据（.admin/）的权限；同机其它用户读不到口令哈希与会话
UMask=0077

# 注意：这里**不用** --pass 传口令（会进 ps 与 journald）。口令已用
#   printf %s "..." | node dev-server.mjs --set-pass --pass-stdin
# 写进 .admin/passphrase.json。
#
# --remote          所有 /api/* 需解锁（含 GET），每客户端会话 cookie
# --public-host     反代带来的真实站点名，加进 Host 白名单
# --public-origin   允许的 Origin，精确匹配；决定 cookie 是否带 Secure
# --trust-proxy     从 X-Forwarded-For 取客户端 IP（退避计数与日志才有意义）
# --proxy-secret-file  nginx 注入的共享密钥，本机其它进程也进不来
# --auto-publish    保存后自动跑 blog-publish（改完即上线）
#
# --session-idle 120：纯 HTTP 阶段把空闲超时压到 2 小时。
#   域名与证书就绪后，追加 --public-origin https://simonfu.xin 并把这里
#   改成 720（12 小时）—— cookie 会自动带上 Secure，风险回到可接受水平。
#
# 【端口分工】本服务监听 8849；8848 留给 p3-admin-proxy（隧道入口）。
#   为什么不让后台直接听 8848：管理面要求请求带 X-Admin-Proxy-Secret，
#   而浏览器走 SSH 隧道时加不了自定义头，必须有反代替它注入。见
#   deploy/systemd/p3-admin-proxy.service。
ExecStart=/usr/local/bin/node /srv/blog/repo/blog-enter/server/dev-server.mjs \
  --port 8849 \
  --remote \
  --public-host 43.108.100.116 \
  --public-host simonfu.xin \
  --public-host www.simonfu.xin \
  --public-origin http://43.108.100.116 \
  --session-idle 120 \
  --trust-proxy \
  --proxy-secret-file /etc/p3blog/proxy-secret \
  --auto-publish

Restart=on-failure
RestartSec=3

# ---- 沙箱 ----
# 注意 ProtectSystem 的两个取值差别（这里很重要，容易写错）：
#   full   → 只有 /usr /boot /etc 变只读，**其余文件系统照旧可写**
#   strict → 整个文件系统只读，只有 ReadWritePaths 里列出的路径可写
# 用 full 的话 ReadWritePaths 既不收紧也不放开，服务实际能写 blog 用户能写的
# 一切（包括 /www/wwwroot 下别人的站点）。所以这里用 strict，并把可写面收到
# 只剩本仓库 —— auto-publish 那步 rsync 进站点根目录是**另一个进程**
# （blog-publish 由本服务 fork 出来），同样受这份沙箱约束，所以站点根目录
# 也必须在 ReadWritePaths 里。
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# 仓库要能写（posts.js / 备份 / 回收站）
ReadWritePaths=/srv/blog/repo
# 站点根目录要能写：--auto-publish 会 fork blog-publish，
# 而它要 rsync 进 /www/wwwroot/<站点>。blog 在 www 组里、目录是 2775。
ReadWritePaths=/www/wwwroot/43.108.100.116
# 反代密钥只读即可；显式声明让它在这种收紧的沙箱下仍然可读
ReadOnlyPaths=/etc/p3blog

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
